# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server listening port (3100 on production Ubuntu VPS, defaults to 3000 locally)
PORT="3100"

# APP_URL: Public domain URL
APP_URL="https://buildsmoremohali.com"
ALLOWED_ORIGINS="https://buildsmoremohali.com,https://www.buildsmoremohali.com"

# PostgreSQL 16 Database
DATABASE_URL="postgresql://buildsmore_admin:YOUR_PASSWORD@localhost:5432/buildsmore_db?sslmode=disable"

# Redis 7 (BullMQ async import queues & rate limits)
REDIS_URL="redis://localhost:6379"

# Media uploads are stored locally on VPS disk in public/uploads/ and served via /uploads

# Admin Authentication & Security (MUST be changed in production)
ADMIN_INITIAL_EMAIL="info@buildsmoremohali.com"
ADMIN_INITIAL_PASSWORD="ChangeMeInProduction2026!"
JWT_SECRET="generate_a_secure_random_64_char_secret"

# Outbound SMTP Email Notifications (Server-Side Only — Never Hardcode Credentials)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="YOUR_SMTP_EMAIL"
SMTP_PASS="YOUR_SMTP_APP_PASSWORD"
SMTP_FROM="BUILDsmore Concierge <YOUR_SMTP_EMAIL>"
INQUIRY_NOTIFY_EMAIL="buildsmore66@gmail.com"
